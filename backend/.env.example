# Entorno LOCAL / DEV. Produccion no usa este archivo: en Cloud Run las
# credenciales vienen de Secret Manager y el resto de variables del deploy.

GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json

# Planilla de DESARROLLO, una copia de la real. Probar en local no deberia
# tocar el inventario de produccion.
GOOGLE_SHEET_NAME=Mi_Cava_Virtual_DEV

# Vacio en DEV: sin bucket, el endpoint de foto responde 503 y la app anda
# igual, sin fotos. Evita ensuciar el bucket de produccion desde local.
GCS_BUCKET_NAME=
GCS_SIGNED_URL_TTL_SECONDS=3600

MAX_IMAGE_SIZE_BYTES=10485760

# Clave de acceso. Vacia en local: la API queda abierta.
# En produccion se genera con: python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_TOKEN=

# Origenes permitidos del frontend, separados por coma.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Limites de uso ---
# Topes por IP en una ventana deslizante. Los defaults del codigo son estos
# mismos, asi que solo hace falta tocarlos para aflojarlos o apretarlos.
# El de scan protege la cuota de Gemini, que es la que cuesta plata: subilo si
# alguna vez cargas una caja entera de una sentada.
SCAN_RATE_LIMIT=20
SCAN_RATE_WINDOW_SECONDS=3600

# Intentos fallidos de token antes de cortar con 429. Los aciertos no gastan
# cupo: el uso normal nunca se bloquea.
AUTH_FAIL_LIMIT=10
AUTH_FAIL_WINDOW_SECONDS=900

# Documentacion interactiva (/docs). En local viene prendida sola; en Cloud Run
# se apaga sola. Poner en 1 solo para depurar contra produccion.
ENABLE_DOCS=
