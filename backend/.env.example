# Entorno LOCAL / DEV. Produccion no usa este archivo: en Cloud Run las
# credenciales vienen de Secret Manager y el resto de variables del deploy.

GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json

# Planilla de DESARROLLO, una copia de la real. Probar en local no deberia
# tocar el inventario de produccion.
GOOGLE_SHEET_NAME=Mi_Cava_Virtual_DEV

# Vacio en DEV: sin bucket, el endpoint de foto responde 503 y la app anda
# igual, sin fotos. Evita ensuciar el bucket de produccion desde local.
GCS_BUCKET_NAME=
GCS_SIGNED_URL_TTL_SECONDS=3600

MAX_IMAGE_SIZE_BYTES=10485760
